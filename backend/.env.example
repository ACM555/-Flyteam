APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional OpenAI-compatible vision endpoint. Leave blank for local OpenCV analysis.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=30

# The official IP Viet Nam site may present an incomplete certificate chain on
# some Windows environments. Keep verification enabled unless you explicitly
# run the refresh script with --insecure.
IP_VIETNAM_BASE_URL=https://wipopublish.ipvietnam.gov.vn/wopublish-search
