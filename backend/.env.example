# ====== 服务配置 ======
APP_NAME=Outbound-Guard API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ====== CORS ======
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ====== 多模态大模型 API（后续接入，暂可留空）======
# OpenAI / 兼容 OpenAI 格式的 API
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Google Gemini（备选）
GEMINI_API_KEY=your-gemini-api-key-here

# ====== 数据存储 ======
UPLOAD_DIR=uploads
REPORT_DIR=reports
DATA_DIR=data
RULES_DIR=rules

# ====== 审查配置 ======
AUDIT_TIMEOUT_SECONDS=60
MAX_IMAGE_SIZE_MB=5
