# ====== 服务配置 ======
APP_NAME=Outbound-Guard API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ====== 超级管理员（必须在本地 .env 中设置，禁止提交真实密码）======
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-local-password

# ====== 比赛演示入口（默认关闭；生产环境建议保持 false）======
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-a-demo-password
DEMO_COMPANY=GoAI 竞赛演示账号

# ====== CORS ======
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ====== 智谱 GLM 模型 API ======
GLM_API_KEY=replace-with-your-glm-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
ASSISTANT_KNOWLEDGE_DIR=data/assistant_knowledge
ASSISTANT_MAX_FILE_MB=10

# ====== 数据存储 ======
UPLOAD_DIR=uploads
REPORT_DIR=reports
DATA_DIR=data
DATABASE_PATH=data/outbound_guard.sqlite3
RULES_DIR=rules

# ====== 审查配置 ======
AUDIT_TIMEOUT_SECONDS=60
MAX_IMAGE_SIZE_MB=5
